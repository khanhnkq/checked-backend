# ============================================================
# Environment variables template for checked-backend
# Copy this file to .env and fill in your own values.
# The .env file is listed in .gitignore and will NOT be committed.
# ============================================================

# ── Database (PostgreSQL - Neon DB / Local) ───────────────
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=your-database-password
DB_URL=jdbc:postgresql://ep-summer-darkness-b3unuia8-pooler.c-4.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require

# ── JWT ──────────────────────────────────────────────────
# Generate a strong random base64 secret, e.g.:
#   openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-base64-secret
JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email / SMTP ─────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
# MAIL_FROM defaults to MAIL_USERNAME if not set
# MAIL_FROM=your-email@gmail.com

# ── Storage Configuration (garage / cloudinary / appwrite) ──
STORAGE_TYPE=garage

# Cấu hình Appwrite Cloud Storage (khi STORAGE_TYPE=appwrite)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=backend-storage-hub
APPWRITE_BUCKET_ID=checked-storage
APPWRITE_API_KEY=your_appwrite_api_key_here

# Cấu hình Garage S3 (khi STORAGE_TYPE=garage)
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_PUBLIC_BASE_URL=http://localhost:3902/locket-photos
GARAGE_ACCESS_KEY_ID=GK000000000000000000000001
GARAGE_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_BUCKET=locket-photos
GARAGE_REGION=garage
# Garage Cluster RPC Secret (32-byte hex string: openssl rand -hex 32)
GARAGE_RPC_SECRET=b4a8e23f98234857ef129845cd782345ba892345ef129845cd782345ba892345
# Garage Admin API Token (openssl rand -base64 32)
GARAGE_ADMIN_TOKEN=garage_admin_secret_token_change_in_production

# Cấu hình Cloudinary (khi STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── MongoDB Atlas (Chat Module) ──────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/checked_chat?retryWrites=true&w=majority&appName=Cluster0
MONGODB_AUTO_INDEX_CREATION=true

# ── WebSocket & Chat Realtime ────────────────────────────────
WS_HEARTBEAT_INCOMING_MS=10000
WS_HEARTBEAT_OUTGOING_MS=10000
CHAT_DEFAULT_PAGE_SIZE=30
CHAT_MAX_PAGE_SIZE=50
CHAT_REVOKE_TIME_LIMIT_MINUTES=60

# ── Redis / Valkey Cloud ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ── RabbitMQ Cloud ───────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL=false

